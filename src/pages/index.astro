---
import Base from '../layouts/Base.astro';
import SceneDemo from '../components/SceneDemo.astro';
import SwitchPlate from '../components/SwitchPlate.astro';
import ServiceGlyph from '../components/ServiceGlyph.astro';
import { sectors } from '../data/products';
import { site, packages, commitments, metrics, scenes, whatsappLink } from '../data/site';

/** Keep the hero's price signal tied to the package data, never retyped. */
const entry = packages[0];

/** Room scenes leads the grid — it is the product, the rest is how it is built. */
const feature = services.find((x) => x.slug === 'room-scenes')!;
const rest = services.filter((x) => x.slug !== feature.slug);
import { services } from '../data/services';
import { u } from '../lib/url';
---

<Base title={`${site.name} — ${site.tagline}`}>
  <section class="hero">
    <div class="wrap">
      <div class="brass-rule"></div>
      <h1 class="dsp">
        Wired for<br />the way you<br />actually live
        <span class="accent-line">switches, curtains, scenes, climate, voice</span>
      </h1>
      <div class="measure" style="margin-top:26px">
        <p class="lede">
          We design your home room by room, install it in days rather than weeks,
          and hand it over working — with the wall switches still doing exactly
          what they always did.
        </p>
      </div>
      <div class="cta">
        <a class="btn btn--primary" href="#packages">See packages &amp; prices</a>
        <a class="btn btn--ghost" href={whatsappLink()} rel="noopener">Ask on WhatsApp</a>
      </div>
      <div class="facts">
        <span class="chip chip--brass">{entry.fits.split(' / ').pop()} {entry.price}</span>
        <span class="chip">Most homes installed in 4 days</span>
        <span class="chip chip--cool">Manual switches always work</span>
      </div>
    </div>
  </section>


  <section class="creds" aria-label="What we commit to">
    <div class="wrap">
      <ul class="creds__list">
        {
          [...metrics, ...commitments].map((c) => (
            <li>
              <span class="creds__v">
                {c.value}
                {c.unit && <em>{c.unit}</em>}
              </span>
              <span class="creds__l">{c.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="sechead"><h2 class="dsp">Try a scene</h2></div>
      <div class="measure" style="margin-top:16px">
        <p class="lede">
          Nobody wants a smart switch. They want the house to already know it is
          evening. Tap one and watch the room.
        </p>
      </div>
      <div style="margin-top:28px">
        <SceneDemo />
      </div>
      <p class="small" style="margin-top:12px">
        This is a real scene — lights, curtains and climate moving on one
        instruction. In your home it runs on a tap, your voice, or by itself at
        sunset.
      </p>
    </div>
  </section>

  <section class="band band--paper" id="services">
    <div class="wrap">
      <div class="sechead"><h2 class="dsp">What we install</h2></div>
      <div class="bento">
        <a class="bento__feature" href={u(`/services/${feature.slug}/`)}>
          <div class="bento__head">
            <span class="eyebrow" style="color:var(--k-1800)">The one that matters</span>
            <ServiceGlyph slug={feature.slug} onNight />
          </div>
          <h3 class="dsp">{feature.name}</h3>
          <p class="bento__thesis">{feature.thesis}</p>
          <p class="bento__lede">{feature.lede}</p>
          <ul class="bento__scenes">
            {scenes.map((sc) => <li>{sc.label}</li>)}
            <li class="bento__scenes--more">and the ones only your house needs</li>
          </ul>
          <span class="bento__more">Read more &rarr;</span>
        </a>

        {
          rest.map((s) => (
            <a class="bento__tile" href={u(`/services/${s.slug}/`)}>
              <ServiceGlyph slug={s.slug} />
              <h3 class="dsp">{s.name}</h3>
              <p>{s.thesis}</p>
              <span class="bento__more">Read more &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>



  <section class="band" id="sectors">
    <div class="wrap">
      <div class="sechead"><h2 class="dsp">Homes, hotels, hospitals</h2></div>
      <div class="measure" style="margin-top:16px">
        <p class="lede">
          The same hardware, three very different briefs. A hotel wants a room
          that costs nothing while it is empty; a hospital wants a switch nobody
          has to reach.
        </p>
      </div>
      <div class="sectors">
        {
          sectors.map((sec) => (
            <article class="sector">
              <span class="eyebrow">{sec.name}</span>
              <h3 class="dsp">{sec.line}</h3>
              <p>{sec.body}</p>
              <ul>
                {sec.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--paper" id="wall">
    <div class="wrap">
      <div class="sechead"><h2 class="dsp">What goes on your wall</h2></div>
      <div class="measure" style="margin-top:16px">
        <p class="lede">
          The question everybody asks at the survey, answered before you book
          one. Two ways to do this, and your back boxes usually decide which.
        </p>
      </div>

      <div class="walls">
        <div class="wall-col">
          <SwitchPlate
            type="modular"
            finish="plaster"
            keys={['1', '2', '3', '4']}
            live={[0, 2]}
            caption="Retrofit — the plate you already own, untouched. Modules go in behind it."
          />
          <div class="wall-note">
            <h3 class="dsp">Retrofit</h3>
            <p>
              Nothing on the wall changes. No chiselling, no repainting, no
              matching new plates to old ones. Cheapest and fastest, and the
              switches keep working exactly as your family expects.
            </p>
            <a class="btn btn--ghost" href={u('/journal/retrofit-modules-vs-touch-panels/')}>
              Which suits my home?
            </a>
          </div>
        </div>

        <div class="wall-col">
          <div class="wall-pair">
            <SwitchPlate finish="plaster" caption="Plaster white" />
            <SwitchPlate finish="graphite" caption="Graphite" />
          </div>
          <div class="wall-note">
            <h3 class="dsp">Touch panel</h3>
            <p>
              Glass, with your scene names engraved on the wall itself — which
              matters more than people expect, because guests and grandparents
              press buttons, not apps. Needs a deeper back box, so we measure
              before we promise.
            </p>
            <a class="btn btn--ghost" href={u('/services/smart-switches/')}>
              About smart switches
            </a>
          </div>
        </div>
      </div>

      <p class="small" style="margin-top:20px">
        Drawn to scale, not photographed — we would rather show you an honest
        diagram than a stock photo of somebody else's living room. Finishes are
        chosen against your scheme at the survey.
      </p>
    </div>
  </section>

  <section class="band" id="packages">
    <div class="wrap">
      <div class="sechead"><h2 class="dsp">Packages</h2></div>
      <div class="measure" style="margin-top:16px">
        <p class="lede">
          Honest ranges, published. Your final number comes from the survey — but
          you should not have to ring us to find out whether we are in your budget.
        </p>
      </div>
      <div class="grid grid--3" style="margin-top:28px">
        {
          packages.map((p) => (
            <div class="card">
              <span class="eyebrow">{p.fits}</span>
              <h3 class="dsp">{p.name}</h3>
              <p>{p.blurb}</p>
              <ul>
                {p.includes.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              <span class="price">{p.price}</span>
            </div>
          ))
        }
      </div>
      <p class="small" style="margin-top:14px">
        Prices are for the core scope and exclude civil work. An estimator that
        prices your exact home is coming — until then, WhatsApp us your floor plan.
      </p>
    </div>
  </section>

  <section class="band band--paper">
    <div class="wrap">
      <div class="sechead"><h2 class="dsp">The honest answers</h2></div>
      <div class="measure" style="margin-top:16px">
        <p class="lede">
          The five things people actually worry about before they buy. We would
          rather answer them here than dodge them on a call.
        </p>
      </div>
      <div class="worries" style="margin-top:26px">
        <div class="worry">
          <h3>What does it really cost to run and maintain?</h3>
          <p>
            Package ranges are published above. Beyond the warranty, an annual
            service plan covers firmware, batteries, re-configuration and
            call-outs, and we will quote it before you commit — not after
            something breaks.
          </p>
        </div>
        <div class="worry">
          <h3>Will it still be working in three years?</h3>
          <p>
            We lead with standards-based hardware, Matter first where it exists,
            so your house does not depend on one company staying interested. Where
            a product is proprietary we say so before you buy it.
          </p>
        </div>
        <div class="worry">
          <h3>What happens when the internet or the power goes?</h3>
          <p>
            Every wall switch keeps working. Automations run locally wherever the
            hardware allows. An outage costs you remote access, not your lights.
          </p>
        </div>
        <div class="worry">
          <h3>Who can see inside my home?</h3>
          <p>
            You choose. Cameras can record locally with nothing leaving the house,
            and voice assistants are optional room by room. We will configure the
            private version by default if you ask.
          </p>
        </div>
        <div class="worry">
          <h3>Is my family going to find this complicated?</h3>
          <p>
            This is the one we care most about. The switches on the wall work the
            way they always have. Scenes run on schedule. Voice needs no screen.
            The app is for whoever in the house enjoys it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band--tight band">
    <div class="wrap">
      <div class="stack g16 measure">
        <div class="brass-rule"></div>
        <h2 class="dsp">Start with a survey</h2>
        <p class="lede">
          We come to your home, look at your wiring and your back boxes, and tell
          you what is possible and what it costs. No obligation, and no quote
          written before we have seen the place.
        </p>
        <div class="hero cta" style="padding:0;border:0;margin-top:8px">
          <a class="btn btn--wa" href={whatsappLink()} rel="noopener">Book on WhatsApp</a>
          <a class="btn btn--ghost" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
