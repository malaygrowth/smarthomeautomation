---
/**
 * A visible note on content that is illustrative rather than a specific
 * customer. It exists so no visitor can mistake a sample for a reference, and
 * it only disappears when the data says the content is real.
 */
interface Props {
  what: string;
}
const { what } = Astro.props;
---

<div class="ph" role="note">
  <span class="ph__tag">Sample</span>
  <p><strong>{what}</strong> It shows the kind of work we do rather than a specific customer, and carries no client name, quote or photograph. Finished installs go up here as we complete them.</p>
</div>

<style>
  .ph {
    display: flex;
    gap: 14px;
    align-items: baseline;
    flex-wrap: wrap;
    border: 1px solid var(--brass);
    background: var(--brass-wash);
    padding: 14px 16px;
  }
  .ph__tag {
    font-family: var(--display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.66rem;
    color: var(--paper);
    background: var(--brass);
    padding: 4px 9px;
    white-space: nowrap;
  }
  .ph p {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-2);
    flex: 1;
    min-width: 220px;
  }
</style>
