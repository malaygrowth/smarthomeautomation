---
import '../styles/global.css';
import { site, whatsappLink } from '../data/site';
import { services } from '../data/services';
import { u } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Pre-fills the WhatsApp message with what the visitor is reading */
  waContext?: string;
  /** Pages with their own prominent WhatsApp CTA suppress the floating one,
   *  so it never sits on top of the thing it duplicates. */
  hideWaFloat?: boolean;
}

const { title, description = site.description, waContext, hideWaFloat = false } = Astro.props;
const path = Astro.url.pathname;
/** Compare against the based URL, since pathname carries the base too. */
const isCurrent = (href: string) => {
  const target = u(href);
  return href === '/' ? path === target : path.startsWith(target);
};

/**
 * The fonts live in public/, so their URLs need the base prefix. CSS files are
 * not rewritten for base, which is why these two faces are declared here rather
 * than in global.css.
 */
const fontCss = `
@font-face{font-family:'Oswald';src:url('${u('/fonts/oswald.woff2')}') format('woff2');font-weight:300 700;font-style:normal;font-display:swap}
@font-face{font-family:'Instrument Serif';src:url('${u('/fonts/instrument-serif-italic.woff2')}') format('woff2');font-weight:400;font-style:italic;font-display:swap}
`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      href={u('/fonts/oswald.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fontCss}></style>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap bar">
        <a class="brand" href={u('/')} aria-label={`${site.name} — home`}>
          <img src={u('/mark.svg')} alt="" width="44" height="28" />
          <span>{site.name}</span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            [
              { href: '/services/', label: 'Services' },
              { href: '/products/', label: 'Products' },
              { href: '/projects/', label: 'Projects' },
              { href: '/how-it-works/', label: 'How it works' },
              { href: '/service-and-amc/', label: 'Service' },
              { href: '/journal/', label: 'Journal' },
            ].map((l) => (
              <a
                class="nav-secondary"
                href={u(l.href)}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))
          }
          <a class="nav-cta" href={u('/estimate/')} aria-current={isCurrent('/estimate/') ? 'page' : undefined}>
            Get an estimate
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          <div>
            <h4>Services</h4>
            <ul>
              {
                services.map((s) => (
                  <li>
                    <a href={u(`/services/${s.slug}/`)}>{s.name}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href={u('/products/')}>Products</a></li>
              <li><a href={u('/projects/')}>Projects</a></li>
              <li><a href={u('/how-it-works/')}>How it works</a></li>
              <li><a href={u('/service-and-amc/')}>Service &amp; AMC</a></li>
              <li><a href={u('/for-designers/')}>For architects &amp; designers</a></li>
              <li><a href={u('/journal/')}>Journal</a></li>
              <li><a href={u('/privacy/')}>Privacy, plainly</a></li>
            </ul>
          </div>
          <div>
            <h4>Talk to us</h4>
            <ul>
              <li><a href={u('/estimate/')}>Get an estimate</a></li>
              <li><a href={whatsappLink(waContext)} rel="noopener">WhatsApp</a></li>
              <li><a href={site.phoneHref}>{site.phone}</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={u('/contact/')}>Contact</a></li>
            </ul>
          </div>
          <div>
            <h4>Where we work</h4>
            <ul>
              {
                site.cities.map((c) => (
                  <li>
                    <a href={u(`/areas/${c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`)}>
                      {c}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="base">
          <span>&copy; {new Date().getFullYear()} {site.name}</span>
          <span>Switches, curtains, scenes, climate and voice.</span>
        </div>
      </div>
    </footer>

    {
      !hideWaFloat && (
        <a
          class="btn btn--wa wa-float"
          href={whatsappLink(waContext)}
          rel="noopener"
          aria-label="Message us on WhatsApp"
        >
          WhatsApp us
        </a>
      )
    }
  </body>
</html>
